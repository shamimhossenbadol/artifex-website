# Copy to .env for local development. Never commit .env (AGENTS §4.8).
# Production values are set in cPanel → Setup Node.js App → Environment variables.

# MySQL/MariaDB connection (02 §7)
DATABASE_URL="mysql://artifex:password@localhost:3306/artifex"

# Signs the admin session JWT. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters-xxxxxxxx"

# Seed only: the predefined admin. Remove ADMIN_INITIAL_PASSWORD after the first login.
ADMIN_EMAIL="admin@artifexfurniture.com"
ADMIN_INITIAL_PASSWORD="change-me-to-a-strong-temporary-password"

# Public URLs (inlined at build time, so also set them where `next build` runs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MEDIA_URL="https://pub-xxxxxxxx.r2.dev"

# Cloudflare R2 (ADR-014). Use the artifex-media-dev bucket locally, never production.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="artifex-media-dev"
